{"nodes": [{"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_copy_feud_played_module", "label": "Decision: copy Feud's played module and routes for Imposter, don't parametrise", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps Feud's played.ts, routes, {surveyId, playerIds} shape and tests untouched; a table-descriptor store plus /api/[game]/played would buy one dedupe implementation for a third game at the cost of reshaping Feud's API now."}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_no_state_version_bump", "label": "Decision: no state change, no stateVersion bump", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swap resolved in deal into existing crew/imposter fields; flag rides on pool items (ContentItem.interchangeable?); a swapped field + bump would discard running sessions and force fixture edits for no behaviour gain."}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_coin_only_for_interchangeable_pairs", "label": "Decision: 50/50 coin drawn only for interchangeable pairs (int(rng,0,1) after bind)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed pair consumes no RNG so every existing engine and demo state is bit-identical."}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_recording_through_onchange", "label": "Decision: record on the client through GameEntry.onchange", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "onchange runs on the play route only so the demo never records; trigger is the crew covered->shown transition, fire-and-forget fetch as in Feud."}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_history_cache_keyed_by_rng_state", "label": "Decision: history fetched once per deal, keyed by s.rng.state", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screen remounts every phase so the fetch lives in a module-level reactive cache; rng.state changes exactly when a round starts or a skip redeals; keying on round alone would serve stale lists to the next game."}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_edit_without_flag_keeps_it", "label": "Decision: edit without the flag keeps it (COALESCE)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_migration_0008_imposter_played", "label": "Migration 0008_imposter_played.sql (imposter_played table + interchangeable column)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forward-only, additive only: new table with FK cascades and a column defaulting to 0."}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_contentitem_interchangeable_and_pairplayed", "label": "ContentItem.interchangeable? and PairPlayed types", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PairPlayed lives in src/lib/content/types.ts, not server, because the client module and the Inhalte page import it."}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_imposter_played_store", "label": "imposter-played.ts store (listImposterPlayed, addImposterPlayed, removeImposterPlayed)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_imposter_played_api_routes", "label": "/api/imposter/played routes (GET, POST, DELETE)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_e2e_helpers_seedpairs", "label": "e2e helpers seedPairs, seedImposterPlayed, imposterPlayed", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_played_svelte_module", "label": "played.svelte.ts client module (record, knownBy, history)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-10-imposter-played-swap/design.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_10_imposter_played_swap_design_engin