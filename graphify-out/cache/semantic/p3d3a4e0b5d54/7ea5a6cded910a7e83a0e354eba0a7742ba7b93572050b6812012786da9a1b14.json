{"nodes": [{"id": "openspec_changes_archive_2026_10_16_faster_ci_design", "label": "Faster CI design", "file_type": "document", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_d1_look_walk_in_beforeall", "label": "D1: Look walk runs in a beforeAll, rules stay separate tests", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scenario names are cited in proof lines of design-system, feud, codes, duck and most-likely; keeping them avoids spec deltas in five capabilities and a red rule stays a red test. describe.serial would skip later rules; expect.soft would rename scenarios."}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_d2_self_sized_tests_run_in_one_project", "label": "D2: Self-sized tests run in one project via test.skip idiom", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phone-only sizes keep touch emulation on phone; desktop setViewportSize is an exact resize. Tags + grepInvert would be a new central pattern with the reason away from the test."}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_d3_gate_runs_check_package_test_unit", "label": "D3: Gate runs check -> package -> test:unit (build once)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "package is the only build; test:unit must follow it because scripts/package.test.ts copies build/."}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_d4_runner_by_event_and_cancel_superseded_pr_runs", "label": "D4: ci.yml picks runner by event and cancels superseded PR runs", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Push runs go to GitHub-hosted ubuntu-24.04 because the release publishes their tarball; keying push runs by SHA means two merges never cancel each other."}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_d5_release_promotes_push_run_artifact", "label": "D5: release.yml promotes the push run's release-tarball artifact", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids rerunning the gate on release; workflow_run trigger rejected because it runs in default-branch context without the tag ref. Retry up to 2 min because the tag can arrive before the run is registered."}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_d6_workers_measured_not_assumed", "label": "D6: Playwright workers measured, not assumed", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4 workers on shared check01 compete with other runners; keep only if e2e step >=20% faster and two consecutive green runs."}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_homelab_check_runner", "label": "homelab-check self-hosted runner (check01)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared 4-core runner with Homelab-Managment and Life-Manager; PR and push runs queued behind each other."}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_release_tarball_artifact", "label": "release-tarball CI artifact", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_wip_ci_release_promotes_ci_artifact_stash", "label": "Parked stash wip ci/release-promotes-ci-artifact", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_10_16_faster_ci_design_look_walk", "label": "Look walk (e2e/look.test.ts)", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "openspec_changes_archive_2026_10_16_faster_ci_design", "target": "openspec_changes_archive_2026_10_16_faster_ci_design_d1_look_walk_in_beforeall", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_10_16_faster_ci_design", "target": "openspec_changes_archive_2026_10_16_faster_ci_design_d2_self_sized_tests_run_in_one_project", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-10-16-faster-ci/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_10_16_faster_ci_design", "target": "openspec_changes_archive_2026_10_16_faster_ci_