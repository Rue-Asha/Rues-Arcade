ive/2026-10-06-family-feud/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the reducer pure: engine appends closed survey ids, the play route POSTs the diff; INSERT OR IGNORE makes resends harmless; lost POSTs accepted."}, {"id": "openspec_changes_archive_2026_10_06_family_feud_design_undo_stack_past", "label": "Undo stack (state.past) saved with the session", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-06-family-feud/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stored in game state so undo survives reload; next clears it."}, {"id": "openspec_changes_archive_2026_10_06_family_feud_design_feud_engine_contract", "label": "FeudState / FeudAction / FeudConfig contract", "file_type": "concept", "source_file": "openspec/changes/archive/2026-10-06-family-feud/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tiebreak survey drawn at Start and stored in config so the engine stays deterministic."}, {"id": "openspec_changes_archive_2026_10_06_family_feud_design_e2e_data_isolation", "label": "Feud e2e data isolation (emptyServer, seedSavedRoster)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-06-family-feud/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both Playwright projects share the e2e DB and layout sync links guests by name, so saved-player tests run on fresh servers."}], "edges": [{"source": "openspec_changes_archive_2026_10_06_family_feud_design", "target": "openspec_changes_archive_2026_10_06_family_feud_design_surveys_own_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-10-06-family-feud/design.md", 