{"nodes": [{"id": "openspec_changes_archive_2026_10_05_party_games_rebuild_design_deco_3_nachtlicht_nachtlicht", "label": "Deko 3 \u00b7 Nachtlicht (Decoration Variant 3 of 3)", "file_type": "document", "source_file": "openspec/changes/archive/2026-10-05-party-games-rebuild/design/deco-3-nachtlicht.html", "source_location": "L1-L596", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No figures, only light: soft glows in game colours behind banners and tiles, dotted rings, fine grain on surfaces and glowing outline icons. Reads like a premium launcher in dimmed light; colour glimmers instead of filling surfaces."}, {"id": "openspec_changes_archive_2026_10_05_party_games_rebuild_design_deco_3_nachtlicht_soft_game_colour_glows", "label": "Soft Game-Colour Glows", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-05-party-games-rebuild/design/deco-3-nachtlicht.html", "source_location": "L227-L245", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Radial glows tinted with game colours (wavelength teal, imposter red, gold) sit behind banners, tiles and boards so colour glimmers rather than fills."}, {"id": "openspec_changes_archive_2026_10_05_party_games_rebuild_design_deco_3_nachtlicht_dotted_rings", "label": "Dotted Rings Ornament", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-05-party-games-rebuild/design/deco-3-nachtlicht.html", "source_location": "L250-L255", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dashed/dotted concentric SVG circles around icons act as a calm ornament (inspired by Oura)."}, {"id": "openspec_changes_archive_2026_10_05_party_games_rebuild_design_deco_3_nachtlicht_grain_noise_texture", "label": "Fine Grain Noise Texture", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-05-party-games-rebuild/design/deco-3-nachtlicht.html", "source_location": "L222-L224", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SVG feTurbulence fractal-noise overlay on banners, tile art, intro, more and board surfaces."}, {"id": "openspec_changes_archive_2026_10_05_party_games_rebuild_design_deco_3_nachtlicht_glowing_outline_icons", "label": "Glowing Outline Icons", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-05-party-games-rebuild/design/deco-3-nachtlicht.html", "source_location": "L251-L253", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large stroked game icons with drop-shadow glow in the game colour replace character illustrations."}, {"id": "openspec_changes_archive_2026_10_05_party_games_rebuild_design_deco_3_nachtlicht_stardust_dots", "label": "Stardust Dot Background", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-05-party-games-rebuild/design/deco-3-nachtlicht.html", "source_location": "L254-L256", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small scattered dots (text/gold) as ambient starfield, after Grok."}, {"id": "openspec_changes_archive_2026_10_05_party_games_rebuild_design_deco_3_nachtlicht_motion_plan", "label": "Nachtlicht Motion Plan", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-05-party-games-rebuild/design/deco-3-nachtlicht.html", "source_location": "L246", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open question: glows drift slowly (16-22 s), the halo under the dial breathes (5 s), rings rotate very slowly (60 s); all off under prefers-reduced-motion. Alternative: only background drift, game screens static."}, {"id": "openspec_changes_archive_2026_10_05_party_games_rebuild_design_deco_3_nachtlicht_reduced_motion_override", "label": "prefers-reduced-motion Override", "file_type": "code", "source_file": "openspec/changes/archive/